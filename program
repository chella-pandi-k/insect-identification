# ============================================================
# TTA (Test-Time Augmentation): horizontal flip & slight rotate
# ============================================================
def tta_predict_single(img_array, model, tta_times=5):
    # img_array: float32 [H,W,3] scaled [0,1]
    imgs = [img_array]
    for _ in range(tta_times-1):
        x = tf.identity(img_array)
        # simple, fast TTA: random flip + small rotate
        x = tf.image.random_flip_left_right(x)
        # rotate by -10..+10 degrees using affine (fast nearest)
        angle = tf.random.uniform([], -10*np.pi/180, 10*np.pi/180)
        x = tfa_image_rotate_fallback(x, angle)  # defined below (no addons)
        imgs.append(x)
    batch = tf.stack(imgs, axis=0)
    preds = model.predict(batch, verbose=0)
    return preds.mean(axis=0)

# Lightweight rotate without tensorflow-addons
def tfa_image_rotate_fallback(image, angle_rad):
    # image: [H,W,3], angle radians, center-based rotation using grid_sample approximation
    # For speed and simplicity, use tf.keras.preprocessing.image smart_resize trick:
    # rotate via tf.raw_ops.ImageProjectiveTransformV3
    h = tf.shape(image)[0]; w = tf.shape(image)[1]
    c = tf.cast(tf.cos(angle_rad), tf.float32)
    s = tf.cast(tf.sin(angle_rad), tf.float32)
    # Construct transform matrix for projective transform
    # [a0, a1, a2, b0, b1, b2] mapping output to input
    # Centered rotation
    cx = (tf.cast(w, tf.float32) - 1.)/2.
    cy = (tf.cast(h, tf.float32) - 1.)/2.
    # translate to origin -> rotate -> translate back
    a0 =  c; a1 =  s; a2 = (1 - c)*-cx - s*-cy
    b0 = -s; b1 =  c; b2 = (1 - c)*-cy + s*-cx
    transform = tf.stack([a0, a1, a2, b0, b1, b2, 0., 0.], axis=0)
    transform = tf.expand_dims(transform, 0)
    image = tf.expand_dims(image, 0)
    out = tf.raw_ops.ImageProjectiveTransformV3(
        images=image, transforms=transform, output_shape=tf.stack([h, w]),
        interpolation="BILINEAR"
    )
    return tf.squeeze(out, 0)

# TTA over the entire test set
tta_probs = []
for i, path in enumerate(test_gen.filepaths):
    img = load_img(path, target_size=(img_size, img_size))
