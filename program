# --- ViT Building Blocks ------------------------------------
class Patches(layers.Layer):
    def __init__(self, size):
        super().__init__()
        self.size = size
    def call(self, images):
        # images: [B, H, W, 3]
        patches = tf.image.extract_patches(
            images=images,
            sizes=[1, self.size, self.size, 1],
            strides=[1, self.size, self.size, 1],
            rates=[1, 1, 1, 1],
            padding="VALID",
        )
        batch = tf.shape(images)[0]
        patch_dim = patches.shape[-1]
        patches = tf.reshape(patches, [batch, -1, patch_dim])
        return patches  # [B, N, P]

class PatchEncoder(layers.Layer):
    def __init__(self, num_patches, embed_dim):
        super().__init__()
        self.proj = layers.Dense(embed_dim)
        self.pos_emb = self.add_weight(
            name="pos_emb",
            shape=(1, num_patches, embed_dim),
            initializer=keras.initializers.RandomNormal(stddev=0.02),
            trainable=True,
        )
        # optional class token (CLS). Using GAP on tokens is simpler & fast; skip CLS for latency
    def call(self, x):
        x = self.proj(x)
        return x + self.pos_emb

def transformer_encoder(x, embed_dim, num_heads, mlp_dim, drop):
    # PreNorm
    x_norm = layers.LayerNormalization(epsilon=1e-6)(x)
    attn_out = layers.MultiHeadAttention(num_heads=num_heads, key_dim=embed_dim)(x_norm, x_norm)
    attn_out = layers.Dropout(drop)(attn_out)
    x = layers.Add()([x, attn_out])

    # MLP
    y = layers.LayerNormalization(epsilon=1e-6)(x)
    y = layers.Dense(mlp_dim, activation='gelu')(y)
    y = layers.Dropout(drop)(y)
    y = layers.Dense(embed_dim)(y)
    y = layers.Dropout(drop)(y)
    return layers.Add()([x, y])

def build_vit(img_size, patch_size, embed_dim, num_heads, num_layers, mlp_dim, drop_rate, num_classes):
    inputs = layers.Input(shape=(img_size, img_size, 3))
    patches = Patches(patch_size)(inputs)
    tokens  = PatchEncoder(num_patches, embed_dim)(patches)

    x = tokens
    for _ in range(num_layers):
        x = transformer_encoder(x, embed_dim, num_heads, mlp_dim, drop_rate)

    x = layers.LayerNormalization(epsilon=1e-6)(x)
    x = layers.GlobalAveragePooling1D()(x)
    x = layers.Dropout(drop_rate)(x)
    outputs = layers.Dense(num_classes, activation='softmax', dtype='float32')(x)  # force fp32 head
    return models.Model(inputs, outputs, name="ViT_pure")

model = build_vit(img_size, patch_size, embed_dim, num_heads, num_layers, mlp_dim, drop_rate, num_classes)
model.summary()

# --- LR Schedule: Warmup + Cosine ---------------------------
steps_per_epoch = max(1, len(train_gen))
total_steps     = steps_per_epoch * epochs
warmup_steps    = steps_per_epoch * warmup_epochs

class WarmupCosine(tf.keras.optimizers.schedules.LearningRateSchedule):
    def __init__(self, base_lr, warmup_steps, total_steps):
        super().__init__()
        self.base_lr = base_lr
        self.warmup_steps = tf.cast(warmup_steps, tf.float32)
        self.total_steps = tf.cast(total_steps, tf.float32)
    def __call__(self, step):
        step = tf.cast(step, tf.float32)
        lr = tf.where(
            step < self.warmup_steps,
            self.base_lr * (step / tf.maximum(1.0, self.warmup_steps)),
            0.5 * self.base_lr * (1 + tf.cos(np.pi * (step - self.warmup_steps) / tf.maximum(1.0, self.total_steps - self.warmup_steps)))
        )
        return lr

lr_schedule = WarmupCosine(base_lr, warmup_steps, total_steps)

# AdamW from tf.keras (no addons)
