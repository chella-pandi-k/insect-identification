print(f"TTA Accuracy: {tta_acc:.4f}")

# ============================================================
# Gradient-based Saliency (ViT-friendly "Grad-CAM-style")
# ============================================================
# Produces heatmaps showing which pixels most influenced the top prediction.
@tf.function
def compute_saliency(model, img_batch):
    with tf.GradientTape() as tape:
        tape.watch(img_batch)
        preds = model(img_batch, training=False)
        top_idx = tf.argmax(preds, axis=1)
        top_scores = tf.gather_nd(preds, tf.stack([tf.range(tf.shape(preds)[0]), top_idx], axis=1))
    grads = tape.gradient(top_scores, img_batch)  # [B,H,W,3]
    grads = tf.reduce_mean(grads, axis=-1, keepdims=True)  # intensity per pixel
    # Normalize to [0,1]
    grads -= tf.reduce_min(grads, axis=[1,2,3], keepdims=True)
    denom = tf.reduce_max(grads, axis=[1,2,3], keepdims=True) + 1e-8
    grads /= denom
    return grads, top_idx

def show_saliency_on_image(img_path, model, class_names, alpha=0.35):
    img = load_img(img_path, target_size=(img_size, img_size))
    x = img_to_array(img)/255.0
    x = np.expand_dims(x.astype('float32'), 0)
    sal, top_idx = compute_saliency(model, tf.convert_to_tensor(x))
    sal = sal.numpy()[0, ..., 0]

    pred = model.predict(x, verbose=0)[0]
    label = class_names[np.argmax(pred)]
    plt.figure(figsize=(8,4))
    plt.subplot(1,2,1); plt.imshow(img); plt.axis('off'); plt.title(f'Pred: {label}')
    plt.subplot(1,2,2); plt.imshow(img); plt.imshow(sal, cmap='jet', alpha=alpha); plt.axis('off'); plt.title('Saliency')
    plt.tight_layout(); plt.show()

